# Paths resolve on the operator's machine.
FPSRG_HOME=./var/fpsrg
FPSRG_API_URL=http://127.0.0.1:8000
FPSRG_API_TOKEN=
FPSRG_SEMANTIC_SUPPORT=true
FPSRG_MAX_TOKENS=4096
FPSRG_REQUEST_TIMEOUT=900

# Optional: manual levels work without these fields.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
